# @(#)sync-from-pi 2.3.map-log.1 2026/10/30 18:30:00

set -x

rsync -Lave ssh pi@pi3:/var/log/roomberry.log ../logs
rsync -Lave ssh pi@pi3:/var/log/roomberry-sensors/ ../logs/sensors/
rsync -Lave ssh pi@pi3:/var/log/roomberry-navlink/ ../logs/navlink/
rsync -Lave ssh pi@pi3:/home/pi/Projects/Roomberry/roomberry/rb.log ../logs
rsync -Lave ssh "pi@pi3:/home/pi/Projects/Roomberry/roomberry/roomberry/map-state*.json" ../logs

rsync -Lave ssh pi@pi3:/var/log/roomberry-maps/ ../logs/maps/
